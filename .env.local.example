# Copie para .env.local (dev) ou cadastre no painel do host (produção, ex.: Vercel).
# Passo a passo completo em LANCAMENTO.md.
# Projeto: AutoManager

# ---- Supabase (OBRIGATÓRIAS - sem elas o servidor não sobe) ----
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://paqsixfvmbkowedvukgz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_publica_anon_ou_publishable
# server-only (NUNCA expor no navegador) - criação de membros, webhook de pagamento, painel admin
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# ---- Domínio público (OBRIGATÓRIA em produção) ----
# Usado no SEO (metadataBase/OG/robots/sitemap) e nas URLs de retorno do Stripe.
# É lida no BUILD: depois de alterar, faça um novo deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (assinaturas dos planos) ----
# Dashboard Stripe > Developers > API keys. Use sk_test_/rk_test_ no local e no staging;
# a chave live (sk_live_/rk_live_) só nas variáveis de Production do host.
# Chave restrita (rk_) precisa de escrita em Customers, Checkout Sessions, Subscriptions,
# Customer portal e Products/Prices, e leitura em Invoices/Events.
STRIPE_SECRET_KEY=sk_test_...      # OBRIGATÓRIA para cobrar - segredo (server-only)
# Segredo do endpoint <NEXT_PUBLIC_APP_URL>/api/stripe/webhook (Developers > Webhooks).
# OBRIGATÓRIA: sem ele o webhook rejeita tudo (renovações/cancelamentos não chegam).
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` mostra um whsec_ de teste.
STRIPE_WEBHOOK_SECRET=whsec_...
# Os preços dos planos são criados com `npm run stripe:sync` (lookup_key automanager_<plano>).

# ---- Só para manutenção local (NÃO cadastrar no host) ----
# Conexão direta ao Postgres, usada apenas para aplicar migrations manualmente.
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Painel NexForge (métricas internas, opcional). Sem as três variáveis nada é enviado.
# Só eventos mínimos com id pseudônimo da loja — nunca dados de clientes ou vendas.
NEXFORGE_ENDPOINT=
NEXFORGE_INGEST_KEY=
# aleatório e exclusivo deste produto (openssl rand -base64 32); nunca compartilhe
NEXFORGE_PSEUDONYM_SECRET=
